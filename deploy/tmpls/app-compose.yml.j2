# App stack. Deployed by deploy/app.yaml. Postgres lives in its own stack
# (deploy/infra.yaml), reached over the shared app_network by hostname, so its
# port is never published to the host or the internet.
services:
  app:
    image: app:{{ docker_image_tag }}
    hostname: app
    container_name: app
    restart: unless-stopped
    environment:
      NODE_ENV: "production"
      DATABASE_URL: "postgres://app:{{ postgres_password }}@postgres:5432/app"
      BETTER_AUTH_SECRET: "{{ better_auth_secret }}"
      BETTER_AUTH_URL: "{{ better_auth_url }}"
      SMTP_HOST: "{{ smtp_host }}"
      SMTP_PORT: "{{ smtp_port }}"
      SMTP_USER: "{{ smtp_user }}"
      SMTP_PASSWORD: "{{ smtp_password }}"
      SMTP_FROM_EMAIL: "{{ smtp_from_email }}"
      SMTP_FROM_NAME: "{{ smtp_from_name }}"
      S3_ENDPOINT: "{{ s3_endpoint }}"
      S3_REGION: "{{ s3_region }}"
      S3_ACCESS_KEY_ID: "{{ s3_access_key_id }}"
      S3_SECRET_ACCESS_KEY: "{{ s3_secret_access_key }}"
      S3_BUCKET_UPLOADS: "{{ s3_bucket_uploads }}"
      ASSETS_BASE_URL: "{{ assets_base_url }}"
      ANALYTICS_GA_MEASUREMENT_ID: "{{ analytics_ga_measurement_id }}"
      PAYMENT_PROVIDER: "{{ payment_provider }}"
      PADDLE_API_KEY: "{{ paddle_api_key }}"
      PADDLE_WEBHOOK_SECRET: "{{ paddle_webhook_secret }}"
      PADDLE_PRICE_ID_MONTHLY: "{{ paddle_price_id_monthly }}"
      PADDLE_PRICE_ID_MONTHLY_NO_TRIAL: "{{ paddle_price_id_monthly_no_trial }}"
    ports:
      - "80:3000"
    networks:
      - app_network

networks:
  app_network:
    external: true
    name: app_network
