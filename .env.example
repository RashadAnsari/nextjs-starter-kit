# Available environments: development, production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Postgres connection string. This value matches the local docker-compose.yml.
DATABASE_URL=postgres://app:secret@localhost:5432/app

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# The secret must be at least 32 characters: openssl rand -base64 32
# BETTER_AUTH_URL is the app's own origin, used for the links in auth emails.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email (required: signup confirmation and password reset)
# ---------------------------------------------------------------------------
# Any SMTP relay works. With Brevo, SMTP_USER is the SMTP login
# (e.g. 8xxxxx@smtp-brevo.com), not the account email, and SMTP_PASSWORD is an
# SMTP key, not the API key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Acme

# ---------------------------------------------------------------------------
# Object storage (optional: only needed by the upload routes)
# ---------------------------------------------------------------------------
# Any S3-compatible provider. On Cloudflare R2 the endpoint is
# https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com and the region is "auto".
# Scope the API token to the upload bucket alone.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_UPLOADS=uploads

# Public base URL for the public assets bucket (or the CDN in front of it).
# No trailing slash. Used to build public asset URLs and to derive the
# Content-Security-Policy media origins in next.config.ts.
ASSETS_BASE_URL=

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# Google Analytics Measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable
# analytics and the cookie consent banner entirely.
ANALYTICS_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Payments (optional)
# ---------------------------------------------------------------------------
# Leave PAYMENT_PROVIDER empty to run without billing. New users then receive
# COMPLIMENTARY_ACCESS_MONTHS of free access (see src/lib/payment/subscription.ts).
# Supported values: "paddle"
PAYMENT_PROVIDER=

# Required when PAYMENT_PROVIDER=paddle.
# PADDLE_CLIENT_TOKEN is the browser-side token that opens the checkout overlay.
# It is public by design. Paddle does not host the checkout page: set the
# default payment link in the Paddle dashboard to https://yourdomain.com/checkout
# so the URL it returns lands on this app's own /checkout route.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# Monthly plan price, configured in Paddle with a free trial (new customers)
PADDLE_PRICE_ID_MONTHLY=
# The same price without a trial (returning customers, no repeat trial)
PADDLE_PRICE_ID_MONTHLY_NO_TRIAL=

# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------
# Tunnel host, no protocol (e.g. abc123.trycloudflare.com). When set,
# next.config.ts adds it to allowedDevOrigins so the dev server is reachable
# through the tunnel's public URL, which is how you test payment webhooks.
DEV_TUNNEL_HOST=
